# ============================================================
# K8s 测试套件拓扑示例（master 节点 = TEST_SERVER_1）
# ============================================================
# 使用方法：
#   1. 复制本文件为仓库根目录 topology.env（或套件内 topology.env）
#   2. 按实际环境修改 HOST（KVM 宿主机可达 IP）与 PORT（master hostfwd 端口）
#   3. topology.env 已在 .gitignore 中，不会提交到仓库
#
# 说明：
#   TEST_SERVER_1 指向 K8s master 节点（riscv64），所有 sonobuoy
#   命令经 hwRunOnServer 1 推送到该节点执行。
#   PORT = master 节点在 KVM 宿主机上的 hostfwd 端口（12055）。
# ============================================================

TEST_SERVER_COUNT=1

# ====== Server 1: K8s master 节点 ======
TEST_SERVER_1_HOST=10.20.237.192
TEST_SERVER_1_PORT=12055
TEST_SERVER_1_USER=openruyi
TEST_SERVER_1_PASSWORD=openruyi
